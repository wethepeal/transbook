# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会进仓库）

# 翻译主引擎（必需，M0 实测 #7 / M1 翻译阶段使用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认端点（默认 https://api.deepseek.com）
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：默认引擎与模型（deepseek-flash 便宜 / deepseek-v4-pro 质量更好）
#TRANSLATE_ENGINE=deepseek
#TRANSLATE_MODEL=deepseek-v4-pro
